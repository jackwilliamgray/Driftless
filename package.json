{
  "name": "driftless",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "Menu-bar tracker for GitHub Actions on your PRs and watched repos",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/jackwilliamgray/Driftless",
  "repository": {
    "type": "git",
    "url": "https://github.com/jackwilliamgray/Driftless.git"
  },
  "bugs": {
    "url": "https://github.com/jackwilliamgray/Driftless/issues"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:arm64": "tauri build --target aarch64-apple-darwin",
    "tauri:build:x86_64": "tauri build --target x86_64-apple-darwin",
    "tauri:build:universal": "tauri build --target universal-apple-darwin",
    "release": "node scripts/release.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-positioner": "^2.3.1",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.14.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4"
  }
